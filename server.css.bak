const http = require("http");
  color-scheme: light;
  --bg: #f7f5ef;
  --surface: #ffffff;
  --surface-strong: #101820;
  --text: #17212b;
  --muted: #66717f;
  --line: #ded8cb;
  --accent: #0f766e;
  --accent-dark: #0b4f4a;
  --gold: #d39a2c;
  --rose: #c95f5f;
  --shadow: 0 24px 70px rgba(23, 33, 43, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px clamp(18px, 4vw, 64px);
  background: rgba(247, 245, 239, 0.88);
  border-bottom: 1px solid rgba(222, 216, 203, 0.72);
  backdrop-filter: blur(16px);
}

.brand {
  font-weight: 800;
  font-size: 1.05rem;
}

.nav {
  display: flex;
  align-items: center;
  gap: 22px;
  color: var(--muted);
  font-size: 0.95rem;
  font-weight: 600;
}

.nav a:hover,
.footer-links a:hover {
  color: var(--accent);
}

.nav-toggle {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid var(--line);
  background: var(--surface);
  border-radius: 8px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6px;
}

.nav-toggle span {
  display: block;
  width: 18px;
  height: 2px;
  background: var(--text);
}

.section {
  padding: 86px clamp(18px, 5vw, 72px);
}

.hero {
  min-height: calc(100vh - 74px);
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
  align-items: center;
  gap: clamp(32px, 5vw, 72px);
  background:
    linear-gradient(135deg, rgba(15, 118, 110, 0.11), transparent 34%),
    linear-gradient(315deg, rgba(211, 154, 44, 0.16), transparent 38%);
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  overflow-wrap: anywhere;
}

h1 {
  max-width: 920px;
  margin: 0;
  font-size: clamp(3rem, 8vw, 7.25rem);
  line-height: 0.95;
  letter-spacing: 0;
}

h1 strong {
  color: var(--accent-dark);
  font-weight: 800;
}

h2 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3.7rem);
  line-height: 1.05;
}

h3 {
  margin: 0;
  font-size: 1.2rem;
}

.hero-summary {
  max-width: 720px;
  margin: 28px 0 0;
  color: var(--muted);
  font-size: clamp(1rem, 2vw, 1.22rem);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 18px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-weight: 800;
  cursor: pointer;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button.primary {
  background: var(--accent);
  color: #ffffff;
}

.button.primary:hover {
  background: var(--accent-dark);
}

.button.secondary {
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.72);
}

.profile-panel {
  display: grid;
  gap: 22px;
  padding: 28px;
  background: var(--surface-strong);
  color: #ffffff;
  border-radius: 8px;
  box-shadow: var(--shadow);
}

.avatar {
  width: 92px;
  height: 92px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--accent), var(--gold));
  border-radius: 8px;
  font-size: 2rem;
  font-weight: 800;
}

.panel-name {
  margin: 0;
  font-size: 1.4rem;
  font-weight: 800;
}

.panel-role {
  margin: 2px 0 0;
  color: rgba(255, 255, 255, 0.7);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.stat {
  min-width: 0;
  padding: 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
}

.stat strong {
  display: block;
  font-size: 1.32rem;
}

.stat span {
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.78rem;
}

.skills-strip {
  padding-top: 24px;
  padding-bottom: 24px;
  background: var(--surface-strong);
  color: #ffffff;
  overflow: hidden;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.skill-pill {
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;
  padding: 9px 14px;
  color: rgba(255, 255, 255, 0.82);
  font-weight: 700;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 34px;
}

.projects-grid,
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.project-card,
.service-card {
  min-width: 0;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 12px 34px rgba(23, 33, 43, 0.06);
}

.project-card img {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  display: block;
  background: #e8e2d7;
}

.project-body,
.service-card {
  padding: 20px;
}

.category {
  margin: 0 0 8px;
  color: var(--rose);
  font-size: 0.82rem;
  font-weight: 800;
}

.project-body p,
.service-card p,
.timeline-item p,
.contact-copy p {
  color: var(--muted);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 18px 0;
}

.tags span {
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 5px 10px;
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 700;
}

.project-links {
  display: flex;
  gap: 12px;
  font-weight: 800;
}

.project-links a {
  color: var(--accent-dark);
}

.split-section {
  background: #ede8df;
}

.timeline {
  display: grid;
  gap: 14px;
  max-width: 980px;
}

.timeline-item {
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  gap: 20px;
  padding: 22px 0;
  border-top: 1px solid var(--line);
}

.timeline-item time {
  color: var(--accent);
  font-weight: 800;
}

.timeline-item p {
  margin-bottom: 0;
}

.contact-section {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1.15fr);
  gap: clamp(28px, 5vw, 70px);
  background: var(--surface-strong);
  color: #ffffff;
}

.contact-copy p {
  color: rgba(255, 255, 255, 0.72);
}

.contact-copy code {
  color: #ffffff;
}

.contact-links {
  display: grid;
  gap: 8px;
  margin-top: 24px;
  font-weight: 800;
}

.contact-links a {
  color: #ffffff;
}

.contact-form {
  display: grid;
  gap: 14px;
}

.contact-form label,
.owner-form label {
  display: grid;
  gap: 7px;
  font-weight: 700;
}

.contact-form label {
  color: rgba(255, 255, 255, 0.78);
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 8px;
  padding: 13px 14px;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  outline: none;
}

.contact-form input:focus,
.contact-form textarea:focus {
  border-color: var(--gold);
}

.form-status {
  min-height: 24px;
  margin: 0;
  color: #ffffff;
  font-weight: 700;
}

.form-status.dark {
  color: var(--text);
}

.owner-section {
  background: #ffffff;
}

.owner-section .section-heading p:not(.eyebrow) {
  color: var(--muted);
}

.owner-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  max-width: 980px;
}

.owner-form input {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 13px 14px;
  background: #ffffff;
  color: var(--text);
  outline: none;
}

.owner-form input:focus {
  border-color: var(--accent);
}

.owner-form button,
.owner-form .form-status {
  grid-column: 1 / -1;
}

.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 26px clamp(18px, 5vw, 72px);
  background: #ffffff;
  border-top: 1px solid var(--line);
  color: var(--muted);
}

.site-footer p {
  margin: 0;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  font-weight: 800;
}

@media (max-width: 920px) {
  .hero,
  .contact-section {
    grid-template-columns: 1fr;
  }

  .projects-grid,
  .services-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 8px 18px 18px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .nav.open {
    display: flex;
  }

  .nav a {
    padding: 12px 0;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .section {
    padding-top: 58px;
    padding-bottom: 58px;
  }

  .hero {
    min-height: auto;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .projects-grid,
  .services-grid {
    grid-template-columns: 1fr;
  }

  .timeline-item {
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .site-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .owner-form {
    grid-template-columns: 1fr;
  }
}
